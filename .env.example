# Required: Claude Opus 4.7 for chat and summary
ANTHROPIC_API_KEY=

# Required only for videos without captions (yt-dlp + Whisper fallback)
OPENAI_API_KEY=

# Optional: path to the SQLite transcript cache. Docker sets this to a
# mounted volume so transcripts survive container restarts.
# YTCHAT_DB_PATH=./ytchat.db

# Optional: HTTP proxy for transcript fetching and yt-dlp audio downloads.
# Set this on hosts whose IP YouTube has rate-limited or blocked (common
# on AWS EC2). Format: http://user:pass@host:port. For Oxylabs residential:
#   http://customer-YOUR_USERNAME:YOUR_PASSWORD@pr.oxylabs.io:7777
# Append -cc-US (or other ISO codes) to the username for country-targeted
# IPs, or -sessid-XYZ for sticky sessions.
# PROXY_URL=
